{
  "name": "safebuild-backend",
  "version": "1.0.0",
  "description": "SafeBuild - Occupational Safety Training, Certification & Reporting System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "test": "jest",
    "test:integration": "NODE_ENV=test jest tests/integration --runInBand",
    "test:performance": "PERF_TARGET=${PERF_TARGET:-http://localhost:5000} artillery run tests/performance/api-load.yml",
    "test:performance:report": "PERF_TARGET=${PERF_TARGET:-http://localhost:5000} artillery run tests/performance/api-load.yml --output tests/performance/last-report.json && artillery report tests/performance/last-report.json"
  },
  "keywords": [
    "safety",
    "training",
    "certification",
    "reporting"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.47.0",
    "@huggingface/inference": "^4.13.15",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "artillery": "^2.0.30",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "tslib": "^2.8.1"
  }
}
