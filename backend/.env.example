PORT=5000
NODE_ENV=production

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/safebuild?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_random_secret_here
JWT_EXPIRE=7d

# OpenRouter AI Configuration (Llama 3.3 70B)
OPENROUTER_API_KEY=sk-or-v1-...

# Hugging Face API Configuration (NLLB Translation)
HUGGINGFACE_API_KEY=hf_...

# Frontend URL (for CORS - set this to your Vercel URL in production)
FRONTEND_URL=https://your-frontend.vercel.app
